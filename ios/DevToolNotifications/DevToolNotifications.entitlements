<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group doubles as the keychain access group the app writes the
	     push keys to (PushKeyStore); the extension can't see the app's other
	     keychain items. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.sk.awantech.devtool</string>
	</array>
</dict>
</plist>
