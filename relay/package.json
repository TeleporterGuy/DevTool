{
  "name": "@devtool/relay",
  "version": "0.1.0",
  "private": true,
  "description": "DevTool mobile relay: authenticates devices and routes end-to-end encrypted frames between paired desktops and phones. No runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "LOG_LEVEL=${LOG_LEVEL:-debug} node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
